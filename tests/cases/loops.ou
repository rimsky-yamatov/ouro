var nbuf[24];

fn puts(s) {
  while (peek(s)) { putc(peek(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  var i;
  if (n == 0) { putc('0'); return 0; }
  if (n < 0) { putc('-'); n = 0 - n; }
  i = 0;
  while (n) { poke(nbuf + i, '0' + n % 10); n = n / 10; i = i + 1; }
  while (i) { i = i - 1; putc(peek(nbuf + i)); }
  return 0;
}

fn line(n) { putnum(n); putc('\n'); return 0; }


fn main() {
  var i;
  var sum;
  var count;
  var j;

  i = 1;
  sum = 0;
  while (i <= 10) { sum = sum + i; i = i + 1; }
  line(sum);

  i = 0;
  while (1) {
    if (i * i > 50) { break; }
    i = i + 1;
  }
  line(i);

  count = 0;
  i = 1;
  while (i <= 3) {
    j = 1;
    while (1) {
      if (j > i) { break; }
      count = count + 1;
      j = j + 1;
    }
    i = i + 1;
  }
  line(count);

  while (0) { putc('x'); }
  puts("done\n");
  return 0;
}
