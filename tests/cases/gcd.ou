var nbuf[24];

fn puts(s) {
  while (peek(s)) { putc(peek(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  var i;
  if (n == 0) { putc('0'); return 0; }
  if (n < 0) { putc('-'); n = 0 - n; }
  i = 0;
  while (n) { poke(nbuf + i, '0' + n % 10); n = n / 10; i = i + 1; }
  while (i) { i = i - 1; putc(peek(nbuf + i)); }
  return 0;
}

fn line(n) { putnum(n); putc('
'); return 0; }


fn gcd(a, b) {
  while (b) { var t; t = b; b = a % b; a = t; }
  return a;
}

fn main() {
  line(gcd(12, 18));
  line(gcd(1071, 462));
  return 0;
}
