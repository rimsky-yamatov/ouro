var nbuf[24];

fn puts(s) {
  while (peek(s)) { putc(peek(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  var i;
  if (n == 0) { putc('0'); return 0; }
  if (n < 0) { putc('-'); n = 0 - n; }
  i = 0;
  while (n) { poke(nbuf + i, '0' + n % 10); n = n / 10; i = i + 1; }
  while (i) { i = i - 1; putc(peek(nbuf + i)); }
  return 0;
}

fn line(n) { putnum(n); putc('
'); return 0; }


fn main() {
  line(1 + 2 * 3);
  line((1 + 2) * 3);
  line(1 + 2 * 3 << 1);
  line(6 & 3 == 2);
  line(1 | 2 ^ 3 & 4);
  line(5 - 3 - 1);
  line(100 / 10 / 5);
  line(-2 + 5);
  line(-(-4));
  line(~0 == -1);
  line(!5);
  line(!0);
  line(!!7);
  line(7 / 2);
  line(-7 / 2);
  line(7 % 3);
  line(-7 % 3);
  line(1 << 62 >> 61);
  line(-8 >> 1);
  line(3 < 4);
  line(4 < 3);
  line(3 <= 3);
  line(-1 < 0);
  line(-1 > 0);
  line(2 + 3 < 4 + 5);
  line(1 < 2 == 1);
  return 0;
}
