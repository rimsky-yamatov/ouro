var nbuf[24];

fn puts(s) {
  while (peek(s)) { putc(peek(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  var i;
  if (n == 0) { putc('0'); return 0; }
  if (n < 0) { putc('-'); n = 0 - n; }
  i = 0;
  while (n) { poke(nbuf + i, '0' + n % 10); n = n / 10; i = i + 1; }
  while (i) { i = i - 1; putc(peek(nbuf + i)); }
  return 0;
}

fn line(n) { putnum(n); putc('\n'); return 0; }

var buf[8];

fn p(c) { putc(c); return c; }
fn pair(a, b) { putc('|'); return 0; }
fn pa() { putc('A'); return buf; }
fn pv() { putc('V'); return 66; }

fn main() {
  pair(p('a'), p('b'));
  putc('\n');
  p('x') + p('y');
  putc('\n');
  poke(pa(), pv());
  putc(peek(buf));
  putc('\n');
  return 0;
}
