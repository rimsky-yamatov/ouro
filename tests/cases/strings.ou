var nbuf[24];

fn puts(s) {
  while (peek(s)) { putc(peek(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  var i;
  if (n == 0) { putc('0'); return 0; }
  if (n < 0) { putc('-'); n = 0 - n; }
  i = 0;
  while (n) { poke(nbuf + i, '0' + n % 10); n = n / 10; i = i + 1; }
  while (i) { i = i - 1; putc(peek(nbuf + i)); }
  return 0;
}

fn line(n) { putnum(n); putc('\n'); return 0; }

fn strlen(s) {
  var n;
  n = 0;
  while (peek(s + n)) { n = n + 1; }
  return n;
}

fn main() {
  var s;
  puts("tab:\there\n");
  line(strlen("a\tb\n\\"));
  puts("quote:\"q\" apostrophe:\'a\' backslash:\\\n");
  line('A');
  line('\n');
  line('\0');
  line('\\');
  s = "ab\0cd";
  puts(s);
  putc('\n');
  line(peek(s + 3));
  return 0;
}
