var nbuf[24];

fn puts(s) {
  while (peek(s)) { putc(peek(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  var i;
  if (n == 0) { putc('0'); return 0; }
  if (n < 0) { putc('-'); n = 0 - n; }
  i = 0;
  while (n) { poke(nbuf + i, '0' + n % 10); n = n / 10; i = i + 1; }
  while (i) { i = i - 1; putc(peek(nbuf + i)); }
  return 0;
}

fn line(n) { putnum(n); putc('\n'); return 0; }

fn weigh(a, b, c, d, e, f, g, h) {
  return a * 10000000 + b * 1000000 + c * 100000 + d * 10000
       + e * 1000 + f * 100 + g * 10 + h;
}
fn one(x) { return x + 1; }
fn zero() { return 7; }
fn add3(a, b, c) { return a + b + c; }

fn main() {
  line(weigh(1, 2, 3, 4, 5, 6, 7, 8));
  line(one(7));
  line(zero());
  line(add3(add3(1, 2, 3), add3(4, 5, 6), 7));
  return 0;
}
