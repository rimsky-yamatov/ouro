var nbuf[24];

fn puts(s) {
  while (peek(s)) { putc(peek(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  var i;
  if (n == 0) { putc('0'); return 0; }
  if (n < 0) { putc('-'); n = 0 - n; }
  i = 0;
  while (n) { poke(nbuf + i, '0' + n % 10); n = n / 10; i = i + 1; }
  while (i) { i = i - 1; putc(peek(nbuf + i)); }
  return 0;
}

fn line(n) { putnum(n); putc('\n'); return 0; }

fn classify(n) {
  if (n < 0) { return 'N'; }
  else if (n == 0) { return 'Z'; }
  else if (n < 10) { return 'S'; }
  else { return 'B'; }
}

fn main() {
  putc(classify(-5));
  putc(classify(0));
  putc(classify(5));
  putc(classify(50));
  putc('\n');
  if (1) {
    if (0) { putc('a'); } else { putc('b'); }
  }
  putc('\n');
  return 0;
}
