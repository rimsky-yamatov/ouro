var nbuf[24];

fn puts(s) {
  while (peek(s)) { putc(peek(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  var i;
  if (n == 0) { putc('0'); return 0; }
  if (n < 0) { putc('-'); n = 0 - n; }
  i = 0;
  while (n) { poke(nbuf + i, '0' + n % 10); n = n / 10; i = i + 1; }
  while (i) { i = i - 1; putc(peek(nbuf + i)); }
  return 0;
}

fn line(n) { putnum(n); putc('\n'); return 0; }

fn main() {
  var i;
  var a;
  var b;
  var c;
  i = 0;
  while (i < 3) {
    var t;
    t = i * 2;
    i = i + 1;
  }
  line(t);
  a = 1;
  b = 2;
  c = 3;
  line(a + b + c);
  return 0;
}
